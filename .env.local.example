# Supabase project the app talks to.
# URL and anon key are safe to expose to the browser; the service-role key is
# server-only and must never be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Absolute origin the app is served from. Used to build links in outbound
# email, so it must match the deployed URL (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email (invites, password resets, task assignments).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
